{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "defender",
      "public": "becze-csalad-defender",
      "ignore": ["README.md", "proba-szimulacio.js", "**/.*"],
      "headers": [
        { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "target": "csillaghajo",
      "public": "becze-csillaghajo",
      "ignore": ["README.md", "TERV.md", "**/.*"],
      "headers": [
        { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "target": "mano",
      "public": "becze-mano-csapat",
      "ignore": ["README.md", "proba-robot.js", "**/.*"],
      "headers": [
        { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    }
  ]
}
