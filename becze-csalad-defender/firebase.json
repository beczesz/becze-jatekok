{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "database.rules.json", "README.md", "proba-szimulacio.js", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
